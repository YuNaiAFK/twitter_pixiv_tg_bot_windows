# Copy this file to .env and fill in your NEW token.

# --- Telegram ---
BOT_TOKEN=PUT_YOUR_NEW_TELEGRAM_BOT_TOKEN_HERE

# --- Login credentials ---
# X/Twitter: a Netscape cookies.txt exported from a logged-in browser. The bot
# needs the auth_token and ct0 cookies.
# TWITTER_COOKIES=cookies/twitter.txt
# Pixiv: artwork pages use Pixiv's App API, which needs an OAuth refresh token.
# A cookie alone is not enough. Get one with:
#   .venv\Scripts\gallery-dl.exe oauth:pixiv
# then paste the value after "code=" from the browser address bar.
# PIXIV_COOKIES=cookies/pixiv.txt
# PIXIV_REFRESH_TOKEN=
# Optional shared file, used when the per-site setting above is empty.
# GALLERY_DL_COOKIES=C:/path/to/cookies.txt
# Set to 0 to skip the local credential sanity check.
CHECK_COOKIES=1
# Warn at startup once a credential has this many days left, so it can be
# re-exported before downloads start failing.
EXPIRY_WARN_DAYS=14

# --- Supported sites ---
# Only X/Twitter, Pixiv and e-hentai links are resolved. Links on any other site
# are never downloaded or fetched, which is what keeps this from becoming a
# general-purpose link fetcher.
SUPPORTED_SITES_NOTICE=目前只支援 X/Twitter、Pixiv 與 e-hentai 連結。
# Reply with the notice above when a link cannot be parsed.
#
# 0 (default) = completely silent: no notice, and no explanation of what an unsupported
#   X/Twitter or Pixiv page is. Suits a public group, where a message for every
#   unparseable link is noise in a conversation the bot was not invited into.
# 1 = send the notice, plus a description of what the page actually is. Useful while
#   checking whether a link is genuinely unsupported or simply misdetected.
#
# This only controls whether the bot SPEAKS. A link that is not a single work is still
# detected and dropped before the downloader runs either way - that is what avoids a
# 180-second stall on a profile, a search page or a ranking page.
REPLY_UNSUPPORTED_LINKS=0

# --- e-hentai / exhentai galleries ---
# A gallery becomes a Telegraph article: cover, gallery facts, and every tag
# grouped by namespace. Adult (H) galleries need a login; public ones do not.
# Extract the e-hentai cookies from a browser export into this file. Needed:
# ipb_member_id, ipb_pass_hash (exhentai also uses sk and igneous).
EHENTAI_COOKIES=cookies/ehentai.txt
# Telegraph's terms forbid adult material, so a page for an H gallery can be
# removed. 1 = always build the page; 0 = answer adult galleries with text only.
TELEGRAPH_ALLOW_ADULT=1
# Author name shown on the Telegraph page.
TELEGRAPH_AUTHOR=e-hentai 解析
EHENTAI_TIMEOUT=60
# Downloading every page is much slower than reading metadata.
EHENTAI_DOWNLOAD_TIMEOUT=900
# Parallel image downloads from e-hentai's CDN. gallery-dl's own extractor waits
# 3-6 seconds between requests, which dominated download time; fetching the image
# URLs directly at this concurrency took a 5-page gallery from 31s to ~3.6s.
EHENTAI_DOWNLOAD_WORKERS=6
# Parallel viewer-page requests while collecting image URLs.
EHENTAI_VIEWER_WORKERS=6

# --- Source link on every result ---
ATTACH_SOURCE_LINK=1
SOURCE_LABEL=原始連結

# --- Cleaning up the chat after a successful request ---
# Remove the "parsing..." notice and the original message that carried the link.
# In a group, deleting the sender's message requires the bot to be an
# administrator with the "Delete messages" right; without it Telegram refuses and
# only the bot's own notice is removed. Set either to 0 to keep the messages.
DELETE_STATUS_MESSAGE=1
DELETE_SOURCE_MESSAGE=1

# --- Limits and access control ---
# Private-chat BLOCKLIST: comma-separated numeric user IDs who may NOT parse.
# Empty means everyone may parse, which is the intended default - parsing is open
# to any visitor, and the list exists to exclude the occasional abuser.
#
# (The older name ALLOWED_USER_IDS is still read, but its IDs now mean "blocked".
#  See the Authorization docstring for why that direction is the safe one.)
BLOCKED_USER_IDS=
# Administrators, comma-separated numeric user IDs. Only these can run /cookies,
# /status, /grant, /revoke and /blocked. Empty means those commands are closed to
# everyone: a public bot must not treat "no admin configured" as "anyone is an admin".
# Get your ID by sending /id to the bot.
ADMIN_USER_IDS=

# Where the runtime authorization lists are kept. They are managed from chat with
# /revoke and /grant, so this file rarely needs editing by hand.
AUTH_FILE=authorized.json
# Group-chat mode: 1 means an empty authorized-group list means NO group may parse,
# 0 means every group may parse. Groups stay an allowlist - the bot serves the groups
# it was deliberately added to. (Private chats have no gate mode: a blocklist is not a
# gate, so AUTH_LOCKED is gone.)
AUTH_GROUP_LOCKED=0
MAX_DOWNLOAD_SECONDS=180
MAX_FILES=20
MAX_UPLOAD_MB=45
MAX_CONCURRENT_DOWNLOADS=2
USER_COOLDOWN_SECONDS=10
# A user may have one request in flight; a second is refused only while one runs.
# This is not a waiting period: a slot is released as soon as its work finishes.
# Reclaims a slot if a request died without releasing it.
REQUEST_STALE_SECONDS=1800

# --- Optional: staging directory on a roomy drive ---
# WORK_DIR=D:/bot_tmp

# --- Optional: gallery-dl cache location ---
# Defaults to .gallery-dl-cache\ next to bot.py. Repointing it matters when the
# user profile is read-only, because gallery-dl's default cache under %APPDATA%
# then fails with "attempt to write a readonly database".
# GALLERY_DL_CACHE=.gallery-dl-cache
# Use your own gallery-dl config file instead of the generated one.
# GALLERY_DL_CONFIG=

# Parsed results are cached so a repeat link needs no download. The cache file
# holds the entries and .cache/ holds copied media files.
CACHE_FILE=parse_cache.json
CACHE_DIR=.cache
# How long an entry stays valid, and how many are kept before the oldest are
# dropped (their files are removed with them).
CACHE_STALE_SECONDS=1209600
CACHE_MAX_ENTRIES=300

# How long a cached e-hentai page-URL list is trusted. The signed URLs in it expire
# in hours while the cache entry lives 14 days, so a stale list is re-swept instead of
# failing every page at once and falling into the serial gallery-dl fallback.
GALLERY_URL_TTL_SECONDS=7200

# How long a REPLACEMENT process (started by /restart) may wait for the
# previous instance to release its single-instance lock. Only the spawner
# marks a process as a replacement, so a normal start from run.bat does not
# read this at all and never waits.
#
# It is a CEILING, not a delay: the lock is normally free the instant the
# old process exits, so a restart resumes in well under a second.
RESTART_STARTUP_DELAY=6
RESTART_LOG_MAX_MB=2

# -------------------- 自架 Telegram Bot API 伺服器（選用）--------------------
# 公開 API 的機器人上傳上限是 50MB，且只能傳檔案位元組。改用自架伺服器後：
#   - 上傳上限提升到 2000MB
#   - 可以直接用本機檔案路徑上傳（需伺服器以 --local 啟動）
# 這讓官方歸檔原圖（約 148MB 以上）與整套 Pixiv 原圖都能完整送出。
#
# 啟動方式： python run_local_api.py
# 伺服器需要你自己的 api_id / api_hash，請到 https://my.telegram.org
# -> API development tools 建立應用程式後填入（這不是 bot token）。
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# 自架伺服器的執行檔路徑（留空會在本目錄與 PATH 尋找 telegram-bot-api）
TELEGRAM_BOT_API_BIN=

# 指向自架伺服器。留空 = 使用公開 api.telegram.org。
TELEGRAM_API_BASE=
# 伺服器以 --local 啟動時設為 1。設 1 才會啟用「用本機路徑上傳」；
# 若伺服器沒開 --local 卻設 1，所有檔案傳送都會失敗。
TELEGRAM_LOCAL=

# 同時處理的更新數量。python-telegram-bot 預設是 1，那會讓「停止」按鈕完全失效：
# 按鈕本身也是一個更新，所以要等阻塞的處理器結束才會被派送，那時停止旗標已被清除。
# 1 會退回舊行為（停止鈕無效、單一請求會凍結所有人）。
MAX_CONCURRENT_UPDATES=4

# 同時進行的 e-hentai 重度工作上限（跨所有聊天室）。每個請求會建立自己的執行緒池，
# 這些池是照「一次只跑一個請求」設計的，所以並行需要這個上限。
# 超過上限的請求會立刻被婉拒，而不是排隊——排隊會佔住更新槽，反而讓停止鈕再次失效。
MAX_CONCURRENT_GALLERY_JOBS=2

# 官方歸檔下載的「總」時間上限（秒），涵蓋探測、所有分段與單一連線備援。
# 5 分鐘對正常情況綽綽有餘（實測 76.3 MiB 原檔約 27 秒）。
# 設為 0 會關閉上限。
ARCHIVE_DEADLINE_SECONDS=300

# 已下載的官方歸檔快取。重複要求同一畫廊時直接重送，不再向 e-hentai 重新取得。
# 實測 76.3 MiB 原檔：第一次 49.7 秒，第二次 0 毫秒。
# 設為 0 可完全停用（除錯時常需要）。
ARCHIVE_CACHE=1

# 歸檔快取的容量上限，超過時淘汰最久未使用的。與圖片快取分開計算。
# 76 MiB 的歸檔約可放 100 個。
ARCHIVE_CACHE_MAX_BYTES=8589934592

# 歸檔快取目錄（預設在 CACHE_DIR/archives 之下）。
# ARCHIVE_CACHE_DIR=
